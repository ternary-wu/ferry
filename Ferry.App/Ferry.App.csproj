<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>false</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="3.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ferry.Core\Ferry.Core.csproj" />
    <ProjectReference Include="..\Ferry.Infrastructure\Ferry.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Plugins\**\*.yaml" CopyToOutputDirectory="PreserveNewest"
             Link="Plugins\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
